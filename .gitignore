# Secrets — this repo is public. Nothing below ever gets committed.
.env
credentials.json
token.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Bundled output
*.bundled.py

# Local test scaffolding
/.sdlc/
_fixtures/

# Machine-local tool settings (the "local" is load-bearing — paths differ per box)
.claude/settings.local.json

# Disposable intermediates (regenerated on demand)
.tmp/

# Vendored binaries: the pin + checksums in third_party/manifest.json are committed,
# the binaries themselves are fetched and verified at init.
third_party/bin/

# Test/coverage output
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# The developer-filled workspace config: names one machine, belongs to nobody else.
/sdlc-workspace.*
sdlc-workspace.*

# The field corpus: names other people's repositories. Same rule, same reason —
# and ban.py --from-corpus seeds the leak guard from it, so the file that names
# them is the file that forbids those names appearing anywhere in this tree.
/sdlc-corpus.*
sdlc-corpus.*
# agent-swarm/: the closure swarm's leader and worker logs, bookkeeping that never ships
agent-swarm/
internal-docs/
# assets/video/: marketing video sources and renders, not harness code. Kept out of git by
# T457: they name another product and machine paths the leak guards ban, and a banned name
# that reaches git history cannot be pinned, only removed by rewriting that history.
# Backed up (2026-09-22) as a STANDALONE repo living in this folder:
# https://github.com/sumitdevgupto/zyroflo-video (private). Publish video changes from inside
# assets/video/ (it has its own .git + remote); never `git add` them here.
assets/video/
