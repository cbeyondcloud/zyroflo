# SDLC harness — environment template. Copy to .env and fill in.
# .env is gitignored; NEVER commit real secrets. CI scans this repo with gitleaks.

# ── Graph substrate ─────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
GRAPH_STORE=neo4j          # neo4j (v1) | sqlite (M6 portability backend)

# ── Estate + pipeline paths ─────────────────────────────────────────────────
WORKSPACE_ROOT=<workspace-root>          # estate root; scanned read-only
SDLC_INTAKE_PATH=.tmp/intake

# ── Least-privilege token split (M3+) ───────────────────────────────────────
# Three distinct credentials by design: a compromised read token must not be able
# to push, and neither must be able to sign an approval.
ESTATE_READ_TOKEN=
ESTATE_PUSH_TOKEN=
APPROVAL_SIGNING_KEY_PATH=
